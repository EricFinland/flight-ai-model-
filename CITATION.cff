    given-names: Eric
    alias: ericfinland
version: 0.1.0
date-released: 2026-10-05
license: MIT
repository-code: "https://github.com/EricFinland/flight-ai-model-"
keywords:
  - language model
  - data curation
  - knowledge removal
  - historical text
  - PG-19
